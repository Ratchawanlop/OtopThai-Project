@model IEnumerable<WebApplication1.Models.Db.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "แดชบอร์ดสินค้า";

    var totalProducts = Model?.Count() ?? 0;
    var outOfStock = Model?.Count(p => p.StockQuantity == 0) ?? 0;
    var lowStock = Model?.Count(p => p.StockQuantity > 0 && p.StockQuantity <= 10) ?? 0;
    var activeStock = totalProducts - outOfStock - lowStock;
    var totalStockValue = Model?.Sum(p => p.StockQuantity * p.ProductPrice) ?? 0;
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0 text-dark fw-bold" style="letter-spacing: -0.5px;">
            <i class="bi bi-speedometer2 text-success me-2"></i>ภาพรวมสินค้า
        </h2>
        <span class="text-muted small">อัปเดตข้อมูลล่าสุด: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 text-white-50 fw-semibold text-uppercase" style="font-size: 0.85rem;">สินค้าทั้งหมด (รายการ)</p>
                            <h3 class="fw-bold mb-0">@totalProducts</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-box-seam fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 text-white-50 fw-semibold text-uppercase" style="font-size: 0.85rem;">สินค้าหมด (รายการ)</p>
                            <h3 class="fw-bold mb-0">@outOfStock</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-x-octagon fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 text-dark text-opacity-75 fw-semibold text-uppercase" style="font-size: 0.85rem;">ใกล้หมดสต็อก </p>
                            <h3 class="fw-bold mb-0">@lowStock</h3>
                        </div>
                        <div class="bg-dark bg-opacity-10 rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-exclamation-triangle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 text-white-50 fw-semibold text-uppercase" style="font-size: 0.85rem;">มูลค่าคลังสินค้ารวม</p>
                            <h3 class="fw-bold mb-0">฿@totalStockValue.ToString("N0")</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h6 class="fw-bold text-dark"><i class="bi bi-pie-chart-fill text-primary me-2"></i>สัดส่วนสถานะสต็อก</h6>
                </div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <div style="width: 100%; max-width: 250px;">
                        <canvas id="stockChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bell-fill text-danger me-2"></i>สินค้าที่ต้องจัดการด่วน (Low/Out of Stock)</h6>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">จัดการสินค้าทั้งหมด</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted" style="font-size: 0.85rem;">
                                <tr>
                                    <th class="ps-4">รหัส</th>
                                    <th>ชื่อสินค้า</th>
                                    <th class="text-end">ราคา</th>
                                    <th class="text-center">สต็อกปัจจุบัน</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    var alertProducts = Model.Where(p => p.StockQuantity == 0 || p.StockQuantity <= 10).OrderBy(p => p.StockQuantity).Take(5).ToList();
                                    if (alertProducts.Any())
                                    {
                                        foreach (var item in alertProducts)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-bold text-secondary">#@item.ProductId</td>
                                                <td class="fw-semibold">@item.ProductName</td>
                                                <td class="text-end">฿@item.ProductPrice.ToString("N2")</td>
                                                <td class="text-center">
                                                    @if (item.StockQuantity == 0)
                                                    {
                                                        <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm">หมดสต็อก</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2 shadow-sm">เหลือ @item.StockQuantity</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="bi bi-check-circle text-success fs-4 d-block mb-2"></i>
                                                สต็อกสินค้าปกติทั้งหมด ไม่มีรายการที่ต้องสั่งเพิ่ม
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const activeStockCount = @activeStock;
            const lowStockCount = @lowStock;
            const outOfStockCount = @outOfStock;

            const ctx = document.getElementById('stockChart').getContext('2d');
            const stockChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['สต็อกปกติ', 'ใกล้หมด', 'หมดสต็อก'],
                    datasets: [{
                        data: [activeStockCount, lowStockCount, outOfStockCount],
                        backgroundColor: [
                            '#198754', // Success (ปกติ)
                            '#ffc107', // Warning (ใกล้หมด)
                            '#dc3545'  // Danger (หมด)
                        ],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { usePointStyle: true, padding: 20 }
                        }
                    }
                }
            });
        });
    </script>
}