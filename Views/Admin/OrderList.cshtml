@model IEnumerable<WebApplication1.Models.Db.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "รายการสั่งซื้อทั้งหมด";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0 text-dark fw-bold" style="letter-spacing: -0.5px;">
            <i class="bi bi-box-seam text-success me-2"></i>จัดการคำสั่งซื้อ
        </h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="orderTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        <tr>
                            <th class="text-center border-bottom-0 rounded-start">Order ID</th>
                            <th class="border-bottom-0">ลูกค้า</th>
                            <th class="border-bottom-0">วันที่สั่งซื้อ</th>
                            <th class="text-end border-bottom-0">ยอดรวม</th>
                            <th class="text-center border-bottom-0">สลิป</th>
                            <th class="text-center border-bottom-0">สถานะ</th>
                            <th class="text-center border-bottom-0 rounded-end">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <a asp-controller="Admin" 
                                        asp-action="OrderDetail" 
                                        asp-route-id="@item.OrderId" 
                                        class="text-primary fw-bold">
                                        #@item.OrderId
                                    </a>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 32px; height: 32px;">
                                            <i class="bi bi-person text-secondary"></i>
                                        </div>
                                        <span class="fw-semibold text-dark">@item.User?.Username</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted" style="font-size: 0.9rem;">
                                        <i class="bi bi-calendar-event me-1"></i> @item.OrderDatetime?.ToString("dd/MM/yyyy")
                                        <br>
                                        <i class="bi bi-clock me-1"></i> @item.OrderDatetime?.ToString("HH:mm") น.
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-success" style="font-size: 1.1rem;">
                                    ฿@item.NetAmount?.ToString("N2")
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.PaymentSlipUrl))
                                    {
                                        <a href="@item.PaymentSlipUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" style="font-weight: 500;">
                                            <i class="bi bi-image me-1"></i> ดูสลิป
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border px-2 py-1 fw-normal">ไม่มีสลิป</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @* ส่วนนี้แก้ไข Badge ให้แสดงผลตรงกับคำศัพท์ใหม่ *@
                                    @if (item.TrackingStatus == "WaitingForReview" || item.TrackingStatus == "WaitingForPayment")
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.3px;">
                                            <i class="bi bi-hourglass-split me-1"></i> รอตรวจสอบยอด
                                        </span>
                                    }
                                    else if (item.TrackingStatus == "Paid" || item.TrackingStatus == "Preparing")
                                    {
                                        <span class="badge rounded-pill bg-info text-dark px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.3px;">
                                            <i class="bi bi-box-seam me-1"></i> เตรียมจัดส่ง
                                        </span>
                                    }
                                    else if (item.TrackingStatus == "Shipped")
                                    {
                                        <span class="badge rounded-pill bg-primary px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.3px;">
                                            <i class="bi bi-truck me-1"></i> กำลังจัดส่ง
                                        </span>
                                    }
                                    else if (item.TrackingStatus == "Delivered" || item.TrackingStatus == "Completed" || item.TrackingStatus == "รับสินค้าแล้ว")
                                    {
                                        <span class="badge rounded-pill bg-success px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.3px;">
                                            <i class="bi bi-check-circle-fill me-1"></i> สำเร็จ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3 py-2 shadow-sm" style="font-weight: 500; letter-spacing: 0.3px;">
                                            <i class="bi bi-info-circle me-1"></i> @(string.IsNullOrEmpty(item.TrackingStatus) ? "รอดำเนินการ" : item.TrackingStatus)
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-action="UpdateOrderStatus" method="post" class="d-inline">
                                        <input type="hidden" name="orderId" value="@item.OrderId" />
                                        
                                        @if (item.TrackingStatus == "WaitingForReview" || item.TrackingStatus == "WaitingForPayment")
                                        {
                                            <button name="newStatus" value="Paid" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm">
                                                <i class="bi bi-check2-circle me-1"></i> ยืนยันยอด
                                            </button>
                                        }
                                        else if (item.TrackingStatus == "Paid" || item.TrackingStatus == "Preparing")
                                        {
                                            <button name="newStatus" value="Shipped" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                                <i class="bi bi-truck me-1"></i> จัดส่งแล้ว
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    
    <style>
        .dataTables_wrapper .row { align-items: center; margin-bottom: 0.5rem; }
        .dataTables_length select { border-radius: 20px; padding-left: 10px; }
        .dataTables_filter input { border-radius: 20px; padding: 4px 15px; }
        .page-item.active .page-link { background-color: var(--otop-green, #198754); border-color: var(--otop-green, #198754); }
        .page-link { border-radius: 8px; margin: 0 2px; color: #495057; }
    </style>

    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#orderTable').DataTable({
                "order": [[2, "desc"]],
                "pageLength": 10,
                "lengthMenu": [10, 25, 50, 100],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/th.json"
                },
                "columnDefs": [
                    { "orderable": false, "targets": [4, 6] }
                ]
            });
        });
    </script>
}