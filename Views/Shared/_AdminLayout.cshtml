<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin OTOP</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --otop-green: #3d5a3e;
            --otop-green-light: #4a6f4b;
            --otop-gold: #c8a45a;
            --otop-cream: #f8f9fa;
            --otop-dark: #2a2a2a;
        }

        body {
            font-family: 'Instrument Sans', sans-serif;
            background-color: var(--otop-cream);
            color: var(--otop-dark);
            overflow-x: hidden;
        }

        /* โครงสร้าง Sidebar */
        .admin-sidebar {
            width: 260px;
            background-color: #ffffff;
            border-right: 1px solid #e9ecef;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1000;
        }

        .admin-brand {
            padding: 20px;
            border-bottom: 1px solid #e9ecef;
        }

        .nav-sidebar {
            padding: 15px 10px;
            flex-grow: 1;
            overflow-y: auto;
        }

        /* ปุ่มเมนูต่างๆ ใน Sidebar */
        .sidebar-link {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: #555;
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: all 0.2s ease;
            font-weight: 500;
        }

        .sidebar-link i {
            font-size: 1.2rem;
            margin-right: 12px;
            color: #888;
            transition: all 0.2s ease;
        }

        .sidebar-link:hover, .sidebar-link.active {
            background-color: rgba(61, 90, 62, 0.08);
            color: var(--otop-green);
        }

        .sidebar-link:hover i, .sidebar-link.active i {
            color: var(--otop-green);
        }

        /* โครงสร้างพื้นที่เนื้อหา (Main Content) */
        .admin-main {
            margin-left: 260px; /* เว้นที่ให้ Sidebar */
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .admin-topbar {
            background-color: #ffffff;
            padding: 15px 30px;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-content {
            padding: 30px;
            flex-grow: 1;
        }

        /* รองรับมือถือ (ปิด Sidebar อัตโนมัติ) */
        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }
            .admin-sidebar.show {
                transform: translateX(0);
            }
            .admin-main {
                margin-left: 0;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <aside class="admin-sidebar shadow-sm" id="sidebar">
        <div class="admin-brand">
            <a href="#" class="text-decoration-none d-flex align-items-center gap-2">
                <span class="fw-bold fs-4" style="color: var(--otop-green);">OTOP</span>
                <span class="text-muted fs-6 mt-1">Admin Panel</span>
            </a>
        </div>

        <div class="nav-sidebar">
            <a href="#" class="sidebar-link">
                <i class="bi bi-grid"></i>
                แดชบอร์ด
            </a>
            
            <p class="text-muted small fw-bold mt-4 mb-2 px-3">การจัดการ</p>
            
            <a asp-controller="Account" asp-action="UserList" class="sidebar-link active">
                <i class="bi bi-people"></i>
                จัดการผู้ใช้งาน
            </a>

            <a href="#" class="sidebar-link">
                <i class="bi bi-box-seam"></i>
                จัดการสินค้า
            </a>
            
            <a href="#" class="sidebar-link">
                <i class="bi bi-receipt"></i>
                รายการสั่งซื้อ
            </a>
        </div>

        <div class="p-3 border-top">
            <a asp-controller="Home" asp-action="Index" class="btn btn-light w-100 text-start border d-flex align-items-center">
                <i class="bi bi-box-arrow-left me-2"></i> กลับหน้าเว็บไซต์
            </a>
        </div>
    </aside>

    <div class="admin-main">
        
        <header class="admin-topbar">
            <div class="d-flex align-items-center">
                <button class="btn btn-light d-lg-none me-3" id="sidebarToggle">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <h4 class="mb-0 fw-bold" style="color: var(--otop-dark);">@ViewData["Title"]</h4>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-md-block">
                    <div class="fw-bold small text-dark">ผู้ดูแลระบบ</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Email</div>
                </div>
                <div class="bg-light rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px; color: var(--otop-green);">
                    <i class="bi bi-person-fill fs-5"></i>
                </div>
            </div>
        </header>

        <div class="px-4 pt-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>

        <main class="admin-content">
            @RenderBody()
        </main>
        
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.getElementById('sidebarToggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('show');
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>