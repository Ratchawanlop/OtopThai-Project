@using WebApplication1.Models.Db
@inject Csi402dbContext _db

@{
    int cartItemCount = 0;
    var currentUserId = Context.Session.GetInt32("UserId");
    if (currentUserId != null)
    {
        var activeCart = _db.Orders.FirstOrDefault(o => o.UserId == currentUserId && o.TrackingStatus == "Pending");
        if (activeCart != null)
        {
            cartItemCount = _db.OrderItems.Where(i => i.OrderId == activeCart.OrderId).Count();
        }
    }
}

<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OTOP Thailand</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif&display=swap"
    rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
        --otop-green: #3d5a3e;
        --otop-green-light: #4a6f4b;
        --otop-gold: #c8a45a;
        --otop-cream: #faf7f2;
        --otop-dark: #2a2a2a;
        }

        body {
        font-family: 'Instrument Sans', sans-serif;
        background-color: var(--otop-cream);
        color: var(--otop-dark);
        scroll-behavior: smooth;
        }

        .font-serif {
        font-family: 'Instrument Serif', serif;
        }

        /* Navbar Customization */
        .navbar-otop {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #e8e0d4;
        }

        .navbar-otop .nav-link {
        color: var(--otop-dark);
        font-weight: 500;
        transition: 0.3s;
        }

        .navbar-otop .nav-link:hover,
        .navbar-otop .nav-link:focus {
        color: var(--otop-green);
        }

        /* ตกแต่งปุ่มและไอคอน */
        .btn-otop {
        background-color: var(--otop-green);
        border-color: var(--otop-green);
        color: #fff;
        padding: 8px 20px;
        border-radius: 8px;
        }

        .btn-otop:hover {
        background-color: var(--otop-green-light);
        border-color: var(--otop-green-light);
        color: #fff;
        box-shadow: 0 4px 12px rgba(61, 90, 62, 0.2);
        }

        .icon-link {
        color: var(--otop-dark);
        transition: color 0.2s;
        }

        .icon-link:hover {
        color: var(--otop-green);
        }

        /* Footer */
        .footer-otop {
        background-color: var(--otop-dark);
        border-top: 4px solid var(--otop-gold);
        }

        html {
        overflow-y: scroll;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">
    <div class="bg-warning text-dark text-center py-1">
        สินค้ามากมายหลายรายการจากทั่วประเทศ! เลือกซื้อสินค้าคุณภาพจากชุมชนท้องถิ่นได้แล้ววันนี้ที่ <b>OTOP Thailand!</b>
    </div>
    <header class="sticky-top navbar-otop shadow-sm">
        <nav class="navbar navbar-expand-lg py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Homepage">
                    <span class="fw-bold fs-3" style="color: var(--otop-green); letter-spacing: -1px;">OTOP</span>
                    <span class="text-muted fs-6 fw-light">THAILAND</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Homepage">หน้าแรก</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Product">สินค้าทั้งหมด</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3" href="#" data-bs-toggle="dropdown">หมวดหมู่</a>
                            <ul class="dropdown-menu shadow-sm border-0 mt-2">
                                <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Product"
                                           asp-route-category="งานสาน"><i class="me-2 text-danger"></i>สินค้างานสาน</a>
                                </li>
                                <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Product"
                                       asp-route-category="ผ้าทอมือ"><i
                                    class="me-2 text-success"></i>สินค้าผ้าทอมือ</a>
                                </li>
                                <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Product"
                                       asp-route-category="ของที่ระลึก"><i
                                    class="me-2 text-warning"></i>ของที่ระลึก</a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">
    
                        <div class="d-none d-md-flex align-items-center">
        
                            <a asp-controller="Home" asp-action="Cart"
                                   class="text-dark position-relative border-0 fs-5 text-decoration-none me-3">
                                <i class="bi bi-cart3"></i>
                                <span id="cartBadge"
                                      class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                      style="font-size: 0.6rem;">
                                    @ViewBag.CartCount
                                </span>
                            </a>

                            <div class="vr mx-2 d-none d-lg-block" style="height: 24px;"></div>
                        </div>

                        <div class="ms-2">
                            <partial name="_LoginPartial" />
                        </div>
    
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-3">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-otop text-white py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-0 small text-secondary">&copy; @DateTime.Now.Year OTOP Thailand Project. Proudly Supporting
                Local Artisans.</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>