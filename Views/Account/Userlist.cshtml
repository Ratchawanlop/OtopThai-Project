@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User List";
}
@model IEnumerable<WebApplication1.Models.Db.User>

<div class="container mt-4">
    <div>
        <h3 class="text-start"><strong>User List</strong></h3>
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <span class="float-end mb-3">
            <a asp-controller="Account" asp-action="AddUser" class="btn btn-sm btn-success">Add User</a>
        </span>
        <div class="mb-3">
            <form asp-controller="Account" asp-action="Search" method="get">
                <input type="text" name="keyword" class="form-control" style="width: 250px; display: inline-block;"
                       placeholder="Search by name or phone..." />
                <button type="submit" class="btn btn-primary btn-sm">Search</button>
            </form>
        </div>
    </div>

    <table class="table table-bordered table-hover align-middle"
           style="text-align: center; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Address</th>
                <th>Role</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserId</td>
                        <td>@user.Username</td>
                        <td>@user.PhoneNumber</td>
                        <td>@user.Email</td>
                        <td>@user.AddressMain</td>
                        <td>
                            @(user.RoleId == 1 ? "User" : "Admin")
                        </td>
                        <td>
                            <a asp-controller="Account" asp-action="EditUser" asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-controller="Account" asp-action="DeleteUser" asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-muted">ไม่มีข้อมูลผู้ใช้งานในระบบ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="7" class="text-start bg-light">
                    Total Users: @(Model?.Count() ?? 0)
                </th>
            </tr>
        </tfoot>
    </table>
</div>