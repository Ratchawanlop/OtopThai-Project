@model WebApplication1.Models.Db.User
@{
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .admin-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        border-top: 5px solid #c9a050; /* เปลี่ยนสีเส้นขอบเป็นสีทอง เพื่อให้รู้ว่าเป็นโหมดแก้ไข */
        background-color: #ffffff;
    }

    .admin-title { color: #c9a050; letter-spacing: 0.5px; }
    .form-label { color: #555; font-size: 0.95rem; }
    .form-control, .form-select { border: 1px solid #dee2e6; border-radius: 8px; padding: 10px 15px; }
    .form-control:focus, .form-select:focus { border-color: #c9a050; box-shadow: 0 0 0 0.25rem rgba(201, 160, 80, 0.25); }
    .btn-admin-save { background-color: #c9a050; border-color: #c9a050; color: white; border-radius: 8px; transition: all 0.2s; }
    .btn-admin-save:hover { background-color: #a8813a; border-color: #a8813a; color: white; transform: translateY(-1px); }
</style>

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-center">
        <div class="admin-card p-4 p-md-5" style="width: 100%; max-width: 650px;">
            
            <div class="text-center mb-4">
                <h3 class="fw-bold admin-title">
                    <i class="bi bi-pencil-square me-2"></i>แก้ไขข้อมูลผู้ใช้งาน
                </h3>
                <p class="text-muted small">รหัสสมาชิก: @Model.UserId</p>
            </div>
            
            <form asp-controller="Account" asp-action="EditUser" method="post">
                
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">ชื่อผู้ใช้ (Username) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                        <input asp-for="Username" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">เบอร์โทรศัพท์ <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-telephone text-muted"></i></span>
                            <input asp-for="PhoneNumber" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">รหัสผ่านใหม่</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key text-muted"></i></span>
                            <input asp-for="PasswordHash" type="password" class="form-control" placeholder="ปล่อยว่างหากใช้รหัสเดิม" value="" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">อีเมล <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="Email" type="email" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">ที่อยู่ (Address)</label>
                    <textarea asp-for="AddressMain" class="form-control" rows="2"></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">สิทธิ์การใช้งาน (Role) <span class="text-danger">*</span></label>
                    <select asp-for="RoleId" class="form-select fw-bold" required>
                        <option value="1">User (ผู้ใช้งานทั่วไป)</option>
                        <option value="2" class="text-danger">Admin (ผู้ดูแลระบบ)</option>
                    </select>
                </div>

                <hr class="my-4 text-muted">

                <div class="d-flex justify-content-end mt-2">
                    <a asp-controller="Account" asp-action="UserList" class="btn btn-light border px-4 fw-bold me-2" style="border-radius: 8px;">
                        ยกเลิก
                    </a>
                    <button type="submit" class="btn btn-admin-save px-4 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> อัปเดตข้อมูล
                    </button>
                </div>
            </form>
            
        </div>
    </div>
</div>