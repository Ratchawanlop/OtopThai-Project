        <div class="col-md-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm card-product">
                <img src="https://mpics.mgronline.com/pics/Images/551000001738201.JPEG" class="card-img-top" alt="ผ้าถุงทอมือ" style="height: 200px; object-fit: cover;">
                <div class="card-body text-center">
                    <h5 class="card-title fs-6">ผ้าถุงทอมือ</h5>
                    <p class="text-success fw-bold fs-5 mb-2">฿650</p>
