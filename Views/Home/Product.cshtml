@model IEnumerable<WebApplication1.Models.Db.Product>
@{
    Layout = "_Aomsin";
    ViewData["Title"] = "หน้าแรก";
}

<div class="container py-5">
    <div class="row align-items-center mb-4 pb-3 border-bottom">
        <div class="col-md-4 mb-3 mb-md-0">
            <h3 class="fw-bold mb-0" style="color: var(--otop-green);">สินค้า OTOP ทั้งหมด</h3>
        </div>
        <div class="col-md-8">
            <div class="d-flex flex-column flex-md-row justify-content-md-end gap-3">
                <div class="input-group" style="max-width: 300px;">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0 ps-0"
                           placeholder="ค้นหาสินค้า...">
                </div>
                <select id="sortFilter" class="form-select w-auto text-secondary fw-medium shadow-sm">
                    <option value="latest">สินค้าล่าสุด</option>
                    <option value="price-asc">ราคา: ต่ำ - สูง</option>
                    <option value="price-desc">ราคา: สูง - ต่ำ</option>
                </select>
            </div>
        </div>
    </div>
    <style>
            /* ซ่อนลูกศรขึ้น-ลงใน Chrome, Safari, Edge, Opera */
            input::-webkit-outer-spin-button,
            input::-webkit-inner-spin-button {
                -webkit-appearance: none;
                margin: 0;
            }

            /* ซ่อนลูกศรขึ้น-ลงใน Firefox */
            input[type=number] {
                -moz-appearance: textfield;
            }
    </style>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4 product-item" data-id="@item.ProductId" data-name="@item.ProductName"
                 data-price="@item.ProductPrice">
                <div class="card h-100 shadow-sm border-0">
            
                    <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.ProductId">
                        <img src="@item.ImageUrl" class="card-img-top p-3" alt="@item.ProductName"
                             style="height: 200px; object-fit: contain;" onerror="this.src='/images/no-image.png'" />
                    </a>
        
                    <div class="card-body text-center d-flex flex-column">
                
                        <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.ProductId"
                               class="text-decoration-none text-dark mb-1">
                            <h6 class="card-title fw-bold mb-0">@item.ProductName</h6>
                        </a>

                        <div class="mb-2">
                            @if (item.ReviewCount > 0)
                            {
                                <div class="text-warning" style="font-size: 0.85rem;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(item.RatingScore ?? 0))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                    <span class="text-muted ms-1" style="font-size: 0.75rem;">(@item.ReviewCount)</span>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    <i class="bi bi-star"></i> ยังไม่มีรีวิว
                                </div>
                            }
                        </div>
                        <h5 class="text-success fw-bold mt-auto">฿@item.ProductPrice</h5>
            
                        <form asp-controller="Home" asp-action="AddToCart" method="post" class="mt-auto">
                            <input type="hidden" name="productId" value="@item.ProductId" />
    
                            @if (item.StockQuantity > 0)
                            {
                                <div class="d-flex justify-content-center align-items-center mb-3">
                                    <div class="input-group input-group-sm"
                                         style="width: 110px; border: 1px solid #dee2e6; border-radius: 5px; overflow: hidden;">
                                        <button class="btn btn-link text-dark text-decoration-none border-0 py-0" type="button"
                                                onclick="this.parentNode.querySelector('input[type=number]').stepDown()">
                                            <i class="bi bi-dash-lg"></i>
                                        </button>
                                        <input type="number" name="quantity" value="1" min="1"
                                               class="form-control border-0 text-center bg-white fw-bold p-0"
                                               style="box-shadow: none; font-size: 0.9rem;" />
                                        <button class="btn btn-link text-dark text-decoration-none border-0 py-0" type="button"
                                                onclick="this.parentNode.querySelector('input[type=number]').stepUp()">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-outline-success rounded-pill px-4 btn-sm w-100">
                                    <i class="bi bi-cart"></i> หยิบใส่ตะกร้า
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary rounded-pill px-4 btn-sm w-100 mt-5" disabled>
                                    สินค้าหมด
                                </button>
                            }
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const sortFilter = document.getElementById('sortFilter');
            const productGrid = document.getElementById('productGrid');
            let products = Array.from(document.querySelectorAll('.product-item'));

            // ------------------------------------
            // 1. ระบบค้นหา (Search) ของเดิม
            // ------------------------------------
            searchInput.addEventListener('input', function (e) {
                const keyword = e.target.value.toLowerCase();
                products.forEach(product => {
                    const productName = product.getAttribute('data-name').toLowerCase();
                    if (productName.includes(keyword)) {
                        product.style.display = 'block';
                    } else {
                        product.style.display = 'none';
                    }
                });
            });

            // ------------------------------------
            // 2. ระบบเรียงลำดับ (Filter / Sort) ของเดิม
            // ------------------------------------
            sortFilter.addEventListener('change', function (e) {
                const sortType = e.target.value;

                products.sort((a, b) => {
                    const priceA = parseFloat(a.getAttribute('data-price'));
                    const priceB = parseFloat(b.getAttribute('data-price'));
                    const idA = parseInt(a.getAttribute('data-id'));
                    const idB = parseInt(b.getAttribute('data-id'));

                    if (sortType === 'price-asc') {
                        return priceA - priceB;
                    } else if (sortType === 'price-desc') {
                        return priceB - priceA;
                    } else {
                        return idB - idA;
                    }
                });

                productGrid.innerHTML = '';
                products.forEach(product => productGrid.appendChild(product));
            });
            
            sortFilter.dispatchEvent(new Event('change'));

            
        });
    </script>
}