@{
    Layout = "_Aomsin";
    ViewData["Title"] = "สั่งซื้อสำเร็จ";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        </div>
        <h2 class="fw-bold text-dark">สั่งซื้อสินค้าสำเร็จ!</h2>
        <p class="text-muted fs-5">เราได้รับหลักฐานการชำระเงินของท่านแล้ว <br> เจ้าหน้าที่จะทำการตรวจสอบและจัดส่งสินค้าโดยเร็วที่สุด</p>
        
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Homepage" class="btn btn-success px-4 py-2 rounded-pill shadow-sm">กลับไปหน้าแรก</a>
            <a asp-controller="Home" asp-action="OrderHistory" class="btn btn-outline-secondary px-4 py-2 rounded-pill ms-2">ดูประวัติการสั่งซื้อ</a>
        </div>
    </div>
</div>