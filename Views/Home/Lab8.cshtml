@using WebApplication1.Models.Db;
@model IEnumerable<WebApplication1.Models.Db.User>

@{
    Layout = "_Aomsin";
}

<div>
    <table class="table table-bordered tabel-striped table-hover">
        <thead>
            <tr>
                <th>User ID</th>
                <th>Phone Number</th>
                <th>Password Hash</th>
                <th>Username</th>
                <th>Email</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
                {
                <tr>
                    <td>@item.UserId</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.PasswordHash</td>
                    <td>@item.Username</td>
                    <td>@item.Email</td>
                    <td>@item.AddressMain</td>
                </tr>
            }
        </tbody>
    </table>
</div>