@model WebApplication1.ViewModels.LoginViewModel
@{
    Layout = "_Aomsin";
    ViewData["Title"] = "เข้าสู่ระบบ";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --otop-green: #2d5a27;
        --otop-gold: #c9a050;
    }

    .login-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 40px 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border-top: 5px solid var(--otop-green);
    }

    .form-control:focus {
        border-color: var(--otop-green);
        box-shadow: none; /* เอาขอบสีน้ำเงินเริ่มต้นของ Bootstrap ออก */
    }

    /* ทำให้ช่องกรอกติดกับไอคอนแบบไร้รอยต่อ */
    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .form-control.border-start-0 {
        background-color: #f8f9fa;
        border-left: none;
    }

    .form-control.border-start-0:focus {
        background-color: #ffffff;
    }
    
    .form-control.border-start-0:focus + .input-group-text,
    .input-group:focus-within .input-group-text {
        background-color: #ffffff;
        border-color: var(--otop-green);
    }

    .btn-login {
        background-color: var(--otop-green);
        color: white;
        transition: all 0.3s;
    }

    .btn-login:hover {
        background-color: #1e3d1a;
        transform: translateY(-2px);
        color: white;
        box-shadow: 0 5px 15px rgba(45, 90, 39, 0.3);
    }

    .login-icon {
        width: 80px;
        height: 80px;
        background-color: #f8f9fa;
        border-radius: 50%;
        padding: 15px;
        margin-bottom: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="login-card">
                
                <div class="text-center mb-4">
                    <img src="https://cdn-icons-png.flaticon.com/512/3177/3177440.png" alt="Login Icon" class="login-icon">
                    <h3 class="fw-bold" style="color: var(--otop-green);">ยินดีต้อนรับกลับมา</h3>
                    <p class="text-muted small">เข้าสู่ระบบเพื่อดำเนินการต่อ</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"
                     style="display:@(ViewContext.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="mb-4">
                        <label asp-for="Phone_number" class="form-label fw-semibold text-secondary small mb-1">เบอร์โทรศัพท์</label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text border-end-0 rounded-start-3">
                                <i class="bi bi-telephone text-muted"></i>
                            </span>
                            <input asp-for="Phone_number" class="form-control border-start-0 ps-0 rounded-end-3"
                                   placeholder="08X-XXX-XXXX" maxlength="10" required />
                        </div>
                        <span asp-validation-for="Phone_number" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary small mb-0">รหัสผ่าน</label>
                            <a href="#" class="small text-decoration-none fw-semibold" style="color: var(--otop-gold);">ลืมรหัสผ่าน?</a>
                        </div>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text border-end-0 rounded-start-3">
                                <i class="bi bi-lock text-muted"></i>
                            </span>
                            <input asp-for="Password" type="password"
                                   class="form-control border-start-0 ps-0 rounded-end-3" 
                                   placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" style="cursor: pointer;" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small" for="rememberMe" style="cursor: pointer;">
                            จดจำการเข้าสู่ระบบ
                        </label>
                    </div>

                    <button type="submit" class="btn btn-login btn-lg w-100 fw-bold rounded-pill">
                        เข้าสู่ระบบ
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <span class="text-muted small">ยังไม่มีบัญชีใช่ไหม?</span>
                    <a href="/Account/Register" class="small fw-bold text-decoration-none ms-1" style="color: var(--otop-green);">
                        สมัครสมาชิกที่นี่
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>