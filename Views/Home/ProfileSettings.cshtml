@model WebApplication1.Models.Db.User 
@{
    Layout = "_Aomsin";
    ViewData["Title"] = "ตั้งค่าโปรไฟล์";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h4 class="mb-0 fw-bold" style="color: var(--otop-green);">
                        <i class="bi bi-person-gear"></i> ตั้งค่าโปรไฟล์
                    </h4>
                </div>
                <div class="card-body p-4">
                    
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Home" asp-action="ProfileSettings" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">ชื่อผู้ใช้</label>
                                <input type="text" class="form-control" name="name" value="@Model.Username" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">เบอร์โทรศัพท์ (อ่านอย่างเดียว แก้ไม่ได้)</label>
                                <input type="text" class="form-control bg-light" value="@Model.PhoneNumber" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">อีเมล</label>
                                <input type="email" class="form-control" name="email" value="@Model.Email">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">ที่อยู่สำหรับจัดส่ง</label>
                                <textarea class="form-control" name="address" rows="3">@Model.AddressMain</textarea>
                            </div>
                            
                            <div class="col-12 mt-4 text-end">
                                <button type="submit" class="btn btn-success px-4 rounded-pill">
                                    <i class="bi bi-save"></i> บันทึกข้อมูล
                                </button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>