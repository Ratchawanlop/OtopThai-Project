@{
    Layout = "_Aomsin";
}

<style>
    /* สไตล์สำหรับตกแต่งหน้าฟอร์มให้ดูพรีเมียม */
    .register-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 40px 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        width: 100%;
        max-width: 500px;
        margin: 50px auto;
        border-top: 5px solid #2d5a27; /* สีเขียวเข้ม สร้างความน่าเชื่อถือ */
    }

    .register-icon {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 50%;
        background-color: #f8f9fa;
        padding: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
        margin-bottom: 5px;
    }

    .form-control {
        border-radius: 10px;
        padding: 12px 15px;
        border: 1px solid #ced4da;
        background-color: #fcfcfc;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #2d5a27;
        box-shadow: 0 0 0 0.25rem rgba(45, 90, 39, 0.15);
        background-color: #ffffff;
    }

    .btn-register {
        background-color: #2d5a27;
        color: white;
        border-radius: 10px;
        padding: 12px;
        font-size: 1.1rem;
        font-weight: bold;
        width: 100%;
        border: none;
        transition: transform 0.2s, background-color 0.2s;
        margin-top: 15px;
    }

    .btn-register:hover {
        background-color: #1e3d1a;
        transform: translateY(-2px); /* เอฟเฟกต์ปุ่มลอยขึ้นตอนชี้ */
        color: white;
    }
</style>

<div class="container d-flex justify-content-center">
    <div class="register-card">
        
        <div class="text-center">
            <img src="https://cdn-icons-png.flaticon.com/512/3177/3177440.png" alt="User Icon" class="register-icon">
            <h3 class="fw-bold mb-1" style="color: #2d5a27;">สมัครสมาชิก</h3>
            <p class="text-muted mb-4">เข้าร่วมกับเราเพื่อรับสิทธิพิเศษมากมาย</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">
            
            <div class="mb-3">
                <label class="form-label">ชื่อผู้ใช้ (Username) :</label>
                <input type="text" name="Username" class="form-control" placeholder="ตั้งชื่อผู้ใช้งานของคุณ" required />
            </div>

            <div class="row mb-3">
                <div class="col-md-6 mb-3 mb-md-0">
                    <label class="form-label">เบอร์โทรศัพท์ :</label>
                    <input type="tel" name="Phone_number" class="form-control" placeholder="08X-XXX-XXXX" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">อีเมล :</label>
                    <input type="email" name="Email" class="form-control" placeholder="example@email.com" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">รหัสผ่าน :</label>
                <input type="password" name="Password_hash" class="form-control" placeholder="ตั้งรหัสผ่านอย่างน้อย 6 ตัวอักษร" required />
            </div>

            <div class="mb-4">
                <label class="form-label">ที่อยู่จัดส่งหลัก :</label>
                <textarea name="AddressMain" class="form-control" rows="2" placeholder="บ้านเลขที่, ซอย, ถนน, ตำบล, อำเภอ, จังหวัด..." required></textarea>
            </div>

            <button type="submit" class="btn btn-register shadow-sm">
                ยืนยันการสมัครสมาชิก
            </button>
            
            <div class="text-center mt-4">
                <span class="text-muted" style="font-size: 0.9rem;">มีบัญชีอยู่แล้ว? </span>
                <a href="/Account/Login" class="text-decoration-none fw-bold" style="color: #2d5a27;">เข้าสู่ระบบที่นี่</a>
            </div>

        </form>
    </div>
</div>