@model WebApplication1.Models.Db.Order
@{
    Layout = "_Aomsin";
    ViewData["Title"] = "ตะกร้าสินค้า";
}

<div class="container py-5">
    <h2 class="fw-bold mb-4" style="color: var(--otop-green);">ตะกร้าสินค้า (ใบรายการสั่งซื้อ)</h2>

    <div class="row">
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start ps-4">ชื่อสินค้า</th>
                                    <th>ราคาต่อชิ้น</th>
                                    <th>จำนวน</th>
                                    <th>รวม (บาท)</th>
                                    <th>จัดการ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model == null || Model.OrderItems == null || !Model.OrderItems.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="py-5 text-muted text-center">ยังไม่มีสินค้าในตะกร้าของคุณ
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        var itemTotal = item.UnitPrice * item.Quantity;
                                        <tr>
                                            <td class="text-start ps-4 fw-medium">@(item.Product != null ?
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        item.Product.ProductName : "ไม่ทราบชื่อสินค้า")</td>
                                                <td>฿@item.UnitPrice.ToString("N2")</td>
        
                                                <td>
                                                    <div class="d-flex justify-content-center">
                                                        <div class="qty-wrapper shadow-sm">
                                                            <button class="qty-btn" type="button"
                                                                    onclick="changeQty('@item.ProductId', '@(item.Product?.ProductName)', -1)">
                                                                <i class="bi bi-dash-lg"></i>
                                                            </button>
            
                                                            <form id="qty-form-@item.ProductId" asp-action="UpdateCartQuantity"
                                                                  asp-controller="Home" method="post" class="m-0 flex-grow-1">
                                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                                <input type="number" name="quantity" id="input-@item.ProductId"
                                                                       class="qty-input-box" value="@item.Quantity" min="0"
                                                                       onchange="this.form.submit()" />
                                                            </form>
            
                                                            <button class="qty-btn" type="button"
                                                                    onclick="changeQty('@item.ProductId', '@(item.Product?.ProductName)', 1)">
                                                                <i class="bi bi-plus-lg"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td class="text-success fw-bold">฿@itemTotal.ToString("N2")</td>

                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            onclick="confirmDelete('@item.ProductId', '@(item.Product?.ProductName)')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
    
                                                    <form id="delete-form-@item.ProductId" asp-action="RemoveFromCart"
                                                          asp-controller="Home" method="post" style="display:none;">
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">สรุปยอดคำสั่งซื้อ</h5>
            
                        <div class="d-flex justify-content-between mb-2">
                            <span>ยอดรวมสินค้า :</span>
                            <span>฿@(Model != null ? (Model.Subtotal ?? 0).ToString("N2") : "0.00")</span>
                        </div>
            
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-success">
                                ส่วนลด
                                @* เพิ่มตรงนี้เข้าไปครับ *@
                                @if (!string.IsNullOrEmpty(ViewBag.PromotionName as string))
                                {
                                    <small class="text-muted ms-1" style="font-size: 0.85em;">
                                        (@ViewBag.PromotionName)
                                    </small>
                                }
                                :
                            </span>
                            <span class="text-success">-฿@(Model != null ? (Model.DiscountAmount ?? 0).ToString("N2") : "0.00")</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>ค่าจัดส่ง :</span>
                            @if (Model != null && (Model.ShippingCost ?? 0) == 0)
                            {
                                <span class="text-success fw-bold">ฟรี</span>
                            }
                            else
                            {
                                <span>฿@(Model != null ? (Model.ShippingCost ?? 0).ToString("N2") : "0.00")</span>
                            }
                        </div>
                        <hr>
            
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold fs-5">ยอดที่ต้องชำระ:</span>
                            <span>฿@(Model != null ? (Model.NetAmount ?? 0).ToString("N2") : "0.00")</span>
                        </div>
        
                        @if (Model != null && Model.OrderItems.Count > 0)
                        {
                            <a asp-action="Checkout" asp-controller="Home"
                               class="btn btn-success w-100">ยืนยันและไปหน้าชำระเงิน</a>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100" disabled>ไม่มีสินค้าให้ชำระเงิน</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<style>
    /* ซ่อนลูกศรเพิ่ม/ลดของตัวเลข */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    /* จัดแต่ง Container ของจำนวนสินค้า */
    .qty-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        width: 130px;
        /* กำหนดความกว้างตายตัว */
        height: 38px;
        overflow: hidden;
        background-color: #fff;
    }

    .qty-btn {
        width: 35px;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        border: none;
        transition: 0.2s;
    }

    .qty-btn:hover {
        background: #e9ecef;
    }

    .qty-input-box {
        flex: 1;
        border: none !important;
        text-align: center;
        font-weight: bold;
        outline: none;
        width: 45px;
    }
</style>
@section Scripts {
    <script>
        function confirmDelete(productId, productName) {
            Swal.fire({
                title: 'ยืนยันการลบสินค้า',
                text: `คุณต้องการลบ "${productName}" ออกจากตะกร้าใช่หรือไม่?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',     // สีแดงสำหรับยืนยัน
                cancelButtonColor: '#6c757d',   // สีเทาสำหรับยกเลิก
                confirmButtonText: 'ใช่, ลบเลย',
                cancelButtonText: 'ยกเลิก',
                reverseButtons: true,           // เอาปุ่มยืนยันไว้ขวาเหมือนมาตรฐานแอปทั่วไป
                borderRadius: '15px'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`delete-form-${productId}`).submit();
                }
            })
        }

        function changeQty(productId, productName, delta) {
            const input = document.getElementById(`input-${productId}`);
            const currentVal = parseInt(input.value);
            const newVal = currentVal + delta;

            if (newVal < 1) {
                // ถ้าลดลงจนเหลือ 0 หรือน้อยกว่า ให้เรียกฟังก์ชันลบที่สวยงาม
                confirmDeleteInCart(productId, productName);
            } else {
                // ถ้าค่ามากกว่า 0 ให้ปรับตัวเลขแล้วส่งฟอร์ม Update ทันที
                input.value = newVal;
                document.getElementById(`qty-form-${productId}`).submit();
            }
        }

        function confirmDeleteInCart(productId, productName) {
            Swal.fire({
                title: 'ต้องการลบสินค้า?',
                text: `คุณต้องการลบ "${productName}" ออกจากตะกร้าใช่หรือไม่?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'ใช่, ลบเลย',
                cancelButtonText: 'ยกเลิก',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`delete-form-${productId}`).submit();
                }
            });
        }
    </script>
}