@model WebApplication1.Models.Db.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "เพิ่มสินค้าใหม่";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0 fw-bold text-dark" style="letter-spacing: -0.5px;">
            <i class="bi bi-plus-circle text-success me-2"></i>เพิ่มสินค้าใหม่
        </h2>
        <a asp-controller="Admin" asp-action="ProductList" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> กลับหน้ารายการ
        </a>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-10">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-5">
                    <form asp-action="CreateProduct" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">ข้อมูลทั่วไป (General Info)</h5>
                        
                        <div class="row g-4 mb-4">
                            <div class="col-md-12">
                                <label asp-for="ProductName" class="form-label fw-semibold text-muted">ชื่อสินค้า <span class="text-danger">*</span></label>
                                <input asp-for="ProductName" class="form-control form-control-lg bg-light" placeholder="ระบุชื่อสินค้า..." required />
                                <span asp-validation-for="ProductName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="CategoryName" class="form-label fw-semibold text-muted">หมวดหมู่สินค้า <span class="text-danger">*</span></label>
                                <input asp-for="CategoryName" class="form-control form-control-lg bg-light" placeholder="เช่น สินค้าทอมือ, สินค้างานสาน..." required />
                                <span asp-validation-for="CategoryName" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2 mt-5">ราคาและสต็อก (Pricing & Stock)</h5>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="ProductPrice" class="form-label fw-semibold text-muted">ราคา (บาท) <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-white">฿</span>
                                    <input asp-for="ProductPrice" type="number" step="0.01" min="0" class="form-control bg-light" placeholder="0.00" required />
                                </div>
                                <span asp-validation-for="ProductPrice" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StockQuantity" class="form-label fw-semibold text-muted">จำนวนในคลัง <span class="text-danger">*</span></label>
                                <input asp-for="StockQuantity" type="number" min="0" class="form-control form-control-lg bg-light" placeholder="0" required />
                                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2 mt-5">รูปภาพ (Media)</h5>

                        <div class="row g-4 mb-4">
                            <div class="col-md-12">
                                <label asp-for="ImageUrl" class="form-label fw-semibold text-muted">URL รูปภาพสินค้า</label>
                                <input asp-for="ImageUrl" class="form-control form-control-lg bg-light" placeholder="https://example.com/image.jpg" />
                                <div class="form-text mt-2">ใส่ลิงก์รูปภาพจากอินเทอร์เน็ต (ถ้ายังไม่มีสามารถเว้นว่างไว้ก่อนได้)</div>
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-5">
                            <button type="reset" class="btn btn-light px-4 py-2 fw-semibold rounded-3">ล้างข้อมูล</button>
                            <button type="submit" class="btn btn-success px-5 py-2 fw-bold shadow-sm rounded-3">
                                <i class="bi bi-save me-2"></i> บันทึกสินค้า
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4 col-lg-2 d-none d-xl-block">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-lightbulb"></i> ข้อแนะนำ</h5>
                    <p class="small text-white-50 mb-0">
                        - ตรวจสอบชื่อสินค้าให้ชัดเจนเพื่อผลลัพธ์การค้นหาที่ดี<br/>
                        - รูปภาพควรมีขนาดสัดส่วน 1:1 เพื่อความสวยงามในหน้าแสดงสินค้า
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}