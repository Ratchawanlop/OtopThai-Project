@using Microsoft.AspNetCore.Http

@{
    var loggedInUser = Context.Session.GetString("Username");
    var roleId = Context.Session.GetInt32("RoleId");
}

<ul class="navbar-nav align-items-center gap-2 m-0 p-0">
    @if (!string.IsNullOrEmpty(loggedInUser))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 text-dark fw-medium" href="#"
                   id="userProfileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle fs-4 text-success"></i>
                <span class="ms-1">@loggedInUser</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userProfileDropdown">
                @if (roleId == 2)
                {
                    <li>
                        <a class="dropdown-item py-2 fw-bold" style="color: var(--otop-green);" asp-controller="Account"
                               asp-action="Userlist">
                            <i class="bi bi-shield-lock-fill me-2"></i>เข้าสู่ระบบจัดการ (Admin)
                        </a>
                    </li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                }
                <li>
                    <a class="dropdown-item py-2" asp-controller="Home" asp-action="OrderHistory">
                        <i class="bi bi-clock-history text-secondary me-2"></i> ประวัติการสั่งซื้อ
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" asp-controller="Home" asp-action="ProfileSettings">
                        <i class="bi bi-person-gear me-2 text-secondary"></i>ตั้งค่าโปรไฟล์
                    </a>
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
                <li>
                    <a class="dropdown-item py-2 text-danger" asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-2"></i>ออกจากระบบ
                    </a>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link fw-medium text-dark" asp-controller="Account" asp-action="Register">สมัครสมาชิก</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-otop px-4 rounded-pill shadow-sm" asp-controller="Account" asp-action="Login">เข้าสู่ระบบ</a>
        </li>
    }
</ul>